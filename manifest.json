{
    "manifest_version": 3,
    "name": "Lunch Lotto",
    "version": "1.1.0",
    "description": "A fun lunch recommendation tool with healthy options! Now with restaurant history tracking (v1.1.0)",
    "permissions": [
      "geolocation",
      "storage",
      "alarms",
      "notifications"
    ],
    "host_permissions": [
      "https://maps.googleapis.com/*"
    ],
    "background": {
      "service_worker": "background.js",
      "type": "module"
    },
    "action": {
      "default_popup": "popup.html",
      "default_icon": "assets/icon.png"
    }
  }